# ============================================================================
# Chat Unificado — Guimarães Melvianna (MVP)
# Variáveis de ambiente. COPIE para .env e ajuste. NUNCA commite o .env.
# Nenhum valor real de canal/token está incluído. Use dados de demonstração.
# ============================================================================

# --- Back-end ---
NODE_ENV=development
PORT=4000

# Banco de dados (PostgreSQL). Ajuste usuário/senha em dev.
# Em produção use segredos fortes e ssl.
DATABASE_URL=postgres://melvianna:melvianna@postgres:5432/melvianna

# --- MODO DEMONSTRAÇÃO (sem credenciais reais) ---
# true = simula Twitch/YouTube/Kick. NUNCA envia para canais reais.
DEMO_MODE=true
DEMO_CHANNEL_TWITCH=melvianna_demo
DEMO_CHANNEL_YOUTUBE=UCmelviannaDemo
DEMO_CHANNEL_KICK=melvianna_demo
DEMO_MESSAGE_RATE_MS=1500

# Plataformas habilitadas para integração REAL (apenas fora do DEMO_MODE)
TWITCH_ENABLED=false
YOUTUBE_ENABLED=false
KICK_ENABLED=false

# --- Overlay OBS (token revogável) ---
OVERLAY_TOKEN=change-me-to-a-long-random-token

# --- Limites / segurança ---
MAX_CHAT_HISTORY=500
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ============================================================================
# Credenciais reais (OPCIONAIS — só para integração real, pós-MVP demo)
# Deixe em branco no MVP. Nunca compartilhe estes valores.
# ============================================================================
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# TWITCH_OAUTH_TOKEN=
# TWITCH_CHANNEL=
# YOUTUBE_API_KEY=
# YOUTUBE_CHANNEL_ID=
# YOUTUBE_OAUTH_TOKEN=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=
# KICK_CHANNEL=
